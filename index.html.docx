
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zodiac Racing 2D</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #101827;
    color: white;
    font-family: Arial, sans-serif;
    text-align: center;
}

header {
    padding: 15px;
    background: #18263d;
}

h1 {
    margin: 5px;
    color: #ffd166;
}

.panel {
    background: #1c2c45;
    padding: 15px;
    margin: 15px auto;
    border-radius: 12px;
    max-width: 650px;
}

input, select, button {
    padding: 10px;
    margin: 5px;
    border-radius: 7px;
    border: none;
    font-size: 15px;
}

button {
    background: #ffd166;
    color: #172033;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #ffb703;
}

#gameArea {
    display: none;
    width: min(96vw, 900px);
    margin: 15px auto;
}

canvas {
    width: 100%;
    height: auto;
    background: #172d32;
    border: 3px solid #ffd166;
    border-radius: 12px;
    display: block;
}

#hud {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
}

.hudItem {
    background: #263b59;
    padding: 10px;
    border-radius: 8px;
    min-width: 110px;
}

#message {
    color: #ffd166;
    min-height: 25px;
    font-weight: bold;
}

.controls {
    margin: 12px;
    color: #cbd5e1;
}
</style>
</head>

<body>

<header>
    <h1>🐉 ZODIAC RACING 2D 🏁</h1>
    <p>Elemental Edition</p>
</header>

<section id="menu" class="panel">
    <h2>Crear corredor zodiacal</h2>

    <p>Fecha de nacimiento</p>

    <input type="number" id="day" placeholder="Día" min="1" max="31">
    <input type="number" id="month" placeholder="Mes" min="1" max="12">
    <input type="number" id="year" placeholder="Año" min="1945" max="2033">

    <br>

    <select id="gender">
        <option value="masculino">Masculino</option>
        <option value="femenino">Femenino</option>
    </select>

    <br>

    <button onclick="createCharacter()">CREAR PERSONAJE</button>

    <div id="characterInfo"></div>
</section>

<section id="gameArea">

    <div id="hud">
        <div class="hudItem">🏁 Vuelta: <span id="lap">1/3</span></div>
        <div class="hudItem">⚡ Velocidad: <span id="speed">0</span>%</div>
        <div class="hudItem">🔮 Poderes: <span id="powers">0</span></div>
        <div class="hudItem">💊 Velocidad: <span id="boosts">0</span></div>
    </div>

    <canvas id="game" width="900" height="650"></canvas>

    <p id="message">¡Prepárate para correr!</p>

    <div class="controls">
        W / S: acelerar y frenar · A / D: girar · ESPACIO: usar poder
    </div>

    <button onclick="restartGame()">REINICIAR CARRERA</button>
</section>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const animals = [
    "Rata","Buey","Tigre","Conejo",
    "Dragón","Serpiente","Caballo","Cabra",
    "Mono","Gallo","Perro","Cerdo"
];

const westernSigns = [
    {name:"Aries", element:"Fuego", start:[3,21], end:[4,19]},
    {name:"Tauro", element:"Tierra", start:[4,20], end:[5,20]},
    {name:"Géminis", element:"Aire", start:[5,21], end:[6,20]},
    {name:"Cáncer", element:"Agua", start:[6,21], end:[7,22]},
    {name:"Leo", element:"Fuego", start:[7,23], end:[8,22]},
    {name:"Virgo", element:"Tierra", start:[8,23], end:[9,22]},
    {name:"Libra", element:"Aire", start:[9,23], end:[10,22]},
    {name:"Escorpio", element:"Agua", start:[10,23], end:[11,21]},
    {name:"Sagitario", element:"Fuego", start:[11,22], end:[12,21]},
    {name:"Capricornio", element:"Tierra", start:[12,22], end:[1,19]},
    {name:"Acuario", element:"Aire", start:[1,20], end:[2,18]},
    {name:"Piscis", element:"Agua", start:[2,19], end:[3,20]}
];

const classes = {
    Fuego: ["Guerrero","Guerrera"],
    Tierra: ["Mago","Maga"],
    Aire: ["Asesino","Asesina"],
    Agua: ["Nigromante","Nigromántica"]
};

const animalEmojis = {
    Rata:"🐀", Buey:"🐂", Tigre:"🐅", Conejo:"🐇",
    Dragón:"🐉", Serpiente:"🐍", Caballo:"🐎", Cabra:"🐐",
    Mono:"🐒", Gallo:"🐓", Perro:"🐕", Cerdo:"🐖"
};

let character = null;
let player = null;
let pickups = [];
let keys = {};
let gameRunning = false;
let lastTime = 0;
let lapProgress = 0;
let totalPowers = 0;
let totalBoosts = 0;
let boostTimer = 0;
let powerTimer = 0;

const center = {x:450, y:325};
const outerRadius = 265;
const innerRadius = 155;
const trackRadius = 210;

function getWesternSign(day, month) {
    for (const sign of westernSigns) {
        const current = month * 100 + day;
        const start = sign.start[0] * 100 + sign.start[1];
        const end = sign.end[0] * 100 + sign.end[1];

        if (start <= end) {
            if (current >= start && current <= end) return sign;
        } else {
            if (current >= start || current <= end) return sign;
        }
    }
    return westernSigns[0];
}

function getChineseAnimal(year) {
    return animals[(year - 2020 + 4 + 120) % 12];
}

function createCharacter() {
    const day = Number(document.getElementById("day").value);
    const month = Number(document.getElementById("month").value);
    const year = Number(document.getElementById("year").value);
    const gender = document.getElementById("gender").value;

    const date = new Date(year, month - 1, day);

    if (
        !day || !month || !year ||
        year < 1945 || year > 2033 ||
        month < 1 || month > 12 ||
        date.getFullYear() !== year ||
        date.getMonth() !== month - 1 ||
        date.getDate() !== day
    ) {
        alert("Introduce una fecha válida entre 1945 y 2033.");
        return;
    }

    const sign = getWesternSign(day, month);
    const animal = getChineseAnimal(year);
    const className = classes[sign.element][gender === "femenino" ? 1 : 0];

    character = {
        sign: sign.name,
        element: sign.element,
        animal,
        className,
        gender,
        emoji: animalEmojis[animal]
    };

    document.getElementById("characterInfo").innerHTML = `
        <h3>Tu corredor está listo</h3>
        <p>${character.emoji} Animal chino: <b>${animal}</b></p>
        <p>♈ Signo: <b>${sign.name}</b></p>
        <p>🌟 Elemento: <b>${sign.element}</b></p>
        <p>⚔️ Clase: <b>${className}</b></p>
        <button onclick="startGame()">COMENZAR CARRERA</button>
    `;
}

function startGame() {
    document.getElementById("menu").style.display = "none";
    document.getElementById("gameArea").style.display = "block";
    restartGame();
}

function restartGame() {
    player = {
        angle: -Math.PI / 2,
        speed: 0,
        maxSpeed: 150,
        color: "#ffd166"
    };

    lapProgress = 0;
    totalPowers = 0;
    totalBoosts = 0;
    boostTimer = 0;
    powerTimer = 0;
    pickups = [];

    createPickups();

    gameRunning = true;
    lastTime = performance.now();

    document.getElementById("message").textContent = "¡La carrera ha comenzado!";
    updateHUD();
    requestAnimationFrame(gameLoop);
}

function createPickups() {
    // 12 poderes y 6 potenciadores por vuelta.
    // Se colocan alrededor del circuito y reaparecen en cada vuelta.
    for (let i = 0; i < 18; i++) {
        const angle = (Math.PI * 2 * i) / 18;
        pickups.push({
            angle,
            type: i % 3 === 0 ? "boost" : "power",
            collected: false
        });
    }
}

function updateHUD() {
    document.getElementById("lap").textContent =
        Math.min(3, Math.floor(lapProgress / (Math.PI * 2)) + 1) + "/3";

    document.getElementById("speed").textContent =
        Math.round(player.speed / player.maxSpeed * 100);

    document.getElementById("powers").textContent = totalPowers;
    document.getElementById("boosts").textContent = totalBoosts;
}

function drawTrack() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = "#244b36";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Exterior de la pista.
    ctx.beginPath();
    ctx.arc(center.x, center.y, outerRadius, 0, Math.PI * 2);
    ctx.fillStyle = "#565c65";
    ctx.fill();

    // Interior.
    ctx.beginPath();
    ctx.arc(center.x, center.y, innerRadius, 0, Math.PI * 2);
    ctx.fillStyle = "#244b36";
    ctx.fill();

    // Líneas de la pista.
    ctx.beginPath();
    ctx.arc(center.x, center.y, (outerRadius + innerRadius) / 2, 0, Math.PI * 2);
    ctx.strokeStyle = "#f5f5f5";
    ctx.lineWidth = 3;
    ctx.setLineDash([18, 15]);
    ctx.stroke();
    ctx.setLineDash([]);

    // Línea de salida.
    ctx.save();
    ctx.translate(center.x, center.y);
    ctx.rotate(-Math.PI / 2);
    ctx.fillStyle = "white";
    for (let i = 0; i < 8; i++) {
        ctx.fillRect(innerRadius + 5 + (i % 2) * 12, -8 + Math.floor(i / 2) * 4, 12, 4);
    }
    ctx.restore();

    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 18px Arial";
    ctx.textAlign = "center";
    ctx.fillText("ZODIAC RACING", center.x, center.y - 15);
    ctx.font = "14px Arial";
    ctx.fillText("PISTA ELEMENTAL", center.x, center.y + 12);
}

function drawPickups() {
    pickups.forEach(item => {
        if (item.collected) return;

        const x = center.x + Math.cos(item.angle) * trackRadius;
        const y = center.y + Math.sin(item.angle) * trackRadius;

        ctx.beginPath();
        ctx.arc(x, y, 11, 0, Math.PI * 2);
        ctx.fillStyle = item.type === "boost" ? "#00e5ff" : "#c77dff";
        ctx.fill();

        ctx.font = "14px Arial";
        ctx.textAlign = "center";
        ctx.fillStyle = "#111";
        ctx.fillText(item.type === "boost" ? "⚡" : "✦", x, y + 5);
    });
}

function drawPlayer() {
    const x = center.x + Math.cos(player.angle) * trackRadius;
    const y = center.y + Math.sin(player.angle) * trackRadius;

    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(player.angle + Math.PI / 2);

    ctx.font = "34px Arial";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(character.emoji, 0, 0);

    ctx.restore();

    ctx.fillStyle = "#fff";
    ctx.font = "12px Arial";
    ctx.textAlign = "center";
    ctx.fillText(character.sign, x, y - 27);
}

function collectPickups() {
    pickups.forEach(item => {
        if (item.collected) return;

        let difference = Math.atan2(
            Math.sin(player.angle - item.angle),
            Math.cos(player.angle - item.angle)
        );

        if (Math.abs(difference) < 0.045) {
            item.collected = true;

            if (item.type === "boost") {
                totalBoosts++;
                boostTimer = 5;
                player.maxSpeed *= 1.15;
                document.getElementById("message").textContent =
                    "⚡ ¡Potenciador de velocidad! +15% durante 5 segundos.";
            } else {
                totalPowers++;
                powerTimer = 4;
                document.getElementById("message").textContent =
                    "🔮 ¡Píldora de poder recogida!";
            }
        }
    });
}

function update(delta) {
    if (!gameRunning) return;

    if (keys["w"] || keys["ArrowUp"]) {
        player.speed += 100 * delta;
    } else {
        player.speed -= 35 * delta;
    }

    if (keys["s"] || keys["ArrowDown"]) {
        player.speed -= 100 * delta;
    }

    player.speed = Math.max(0, Math.min(player.maxSpeed, player.speed));

    let steering = 0;
    if (keys["a"] || keys["ArrowLeft"]) steering = -1;
    if (keys["d"] || keys["ArrowRight"]) steering = 1;

    const turnSpeed = player.speed / 150;
    player.angle += steering * turnSpeed * delta;

    const previousLap = Math.floor(lapProgress / (Math.PI * 2));

    lapProgress += (player.speed / trackRadius) * delta;

    const currentLap = Math.floor(lapProgress / (Math.PI * 2));

    if (currentLap > previousLap) {
        if (currentLap >= 3) {
            finishGame();
            return;
        }

        pickups.forEach(item => item.collected = false);
        document.getElementById("message").textContent =
            "¡Vuelta completada! Comienza la siguiente.";
    }

    collectPickups();

    if (boostTimer > 0) {
        boostTimer -= delta;
        if (boostTimer <= 0) {
            player.maxSpeed = 150;
        }
    }

    if (powerTimer > 0) {
        powerTimer -= delta;
    }

    updateHUD();
}

function draw() {
    drawTrack();
    drawPickups();
    drawPlayer();
}

function gameLoop(timestamp) {
    if (!gameRunning) return;

    const delta = Math.min((timestamp - lastTime) / 1000, 0.05);
    lastTime = timestamp;

    update(delta);
    draw();

    if (gameRunning) {
        requestAnimationFrame(gameLoop);
    }
}

function finishGame() {
    gameRunning = false;
    player.speed = 0;
    draw();

    document.getElementById("message").textContent =
        "🏆 ¡FELICITACIONES! ¡Has completado las 3 vueltas!";
}

function usePower() {
    if (!gameRunning || totalPowers <= 0) return;

    totalPowers--;
    player.speed = player.maxSpeed;
    powerTimer = 3;

    document.getElementById("message").textContent =
        "✨ ¡Poder zodiacal activado!";
    updateHUD();
}

window.addEventListener("keydown", e => {
    const key = e.key.toLowerCase();
    keys[key] = true;

    if (e.code === "Space") {
        e.preventDefault();
        usePower();
    }
});

window.addEventListener("keyup", e => {
    keys[e.key.toLowerCase()] = false;
});
</script>

</body>
</html>
